<div class="min-h-screen bg-slate-900 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-white">アカウント設定</h2>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <!-- 資質設定へのリンク -->
    <div class="bg-slate-800 py-4 px-4 shadow sm:rounded-lg sm:px-10 border border-slate-700 mb-6">
      <h3 class="text-lg font-medium leading-6 text-white mb-4">資質の設定</h3>
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-400">あなたのTOP5資質を変更します。</p>
        <%= link_to "変更する", edit_user_strengths_path, class: "rounded-md bg-orange-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 transition-colors" %>
      </div>
    </div>

    <!-- アカウント削除 -->
    <div class="bg-slate-800 py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-slate-700">
      <h3 class="text-sm font-medium leading-6 text-white mb-4">アカウント管理</h3>

      <div>
        <h3 class="text-sm font-medium leading-6 text-red-400">アカウントの削除</h3>
        <p class="mt-1 text-sm text-slate-500">一度削除すると元に戻せません。</p>
        <div class="mt-4">
          <%= button_to "アカウントを削除する", registration_path(resource_name), data: { confirm: "本当によろしいですか？", turbo_confirm: "本当によろしいですか？" }, method: :delete, class: "text-sm font-semibold text-red-500 hover:text-red-400 transition-colors" %>
        </div>
      </div>
      
      <div class="mt-6 text-center">
        <%= link_to "戻る", :back, class: "text-sm text-slate-400 hover:text-white" %>
      </div>
    </div>
  </div>
</div>
