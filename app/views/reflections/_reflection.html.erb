<div id="<%= dom_id reflection %>" class="space-y-4 animate-fade-in-up">
  <!-- ユーザーの投稿（右側） -->
  <div class="flex justify-end">
    <div class="bg-orange-900/40 text-slate-100 rounded-2xl rounded-tr-none px-5 py-3 shadow-sm max-w-[85%] border border-orange-500/20">
      <p class="text-sm whitespace-pre-wrap"><%= reflection.content %></p>
      <div class="mt-1 text-xs text-orange-400/60 text-right">
        <%= l reflection.created_at, format: :short %>
      </div>
    </div>
  </div>

  <!-- AIの返信（左側） -->
  <% if reflection.ai_question.present? %>
    <div class="flex justify-start">
      <div class="flex items-end gap-2 max-w-[85%]">
        <!-- アイコン（焚き火） -->
        <div class="flex-shrink-0 mb-1 text-orange-500 bg-orange-950/30 p-2 rounded-full border border-orange-500/30 shadow-[0_0_15px_rgba(249,115,22,0.2)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-1.64-.921 1.74 1.74 0 00-1.658.245A3.75 3.75 0 0012 18z" />
          </svg>
        </div>
        <!-- メッセージ -->
        <% animate = local_assigns[:animate] || false %>
        <div class="bg-stone-900/80 text-orange-100/90 rounded-2xl rounded-tl-none px-5 py-4 shadow-sm border border-orange-500/10 backdrop-blur-sm">
          <p class="text-sm whitespace-pre-wrap leading-relaxed" data-controller="typewriter" data-typewriter-animate-value="<%= animate %>"><%= reflection.ai_question %></p>
        </div>
      </div>
    </div>
  <% elsif reflection.generating? %>
    <div class="flex justify-start">
      <div class="flex items-end gap-2 max-w-[85%]">
        <!-- アイコン（ゆらぎ） -->
        <div class="flex-shrink-0 mb-1 text-orange-500/80 bg-orange-950/20 p-2 rounded-full border border-orange-500/10">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 animate-pulse">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-1.64-.921 1.74 1.74 0 00-1.658.245A3.75 3.75 0 0012 18z" />
          </svg>
        </div>
        <!-- Thinking（火の粉） -->
        <div class="bg-stone-900/60 text-orange-200/50 rounded-2xl rounded-tl-none px-5 py-4 shadow-sm border border-orange-500/5">
          <div class="flex gap-2 h-5 items-center px-1">
             <!-- ゆらめく火の粉アニメーション -->
            <div class="w-1.5 h-1.5 bg-orange-500 rounded-full animate-ping [animation-duration:2s]"></div>
            <div class="w-1.5 h-1.5 bg-orange-400 rounded-full animate-ping [animation-duration:2s] [animation-delay:0.5s]"></div>
            <div class="w-1.5 h-1.5 bg-red-500 rounded-full animate-ping [animation-duration:2s] [animation-delay:1s]"></div>
          </div>
        </div>
      </div>
    </div>
  <% elsif reflection.failed? %>
    <div class="flex justify-start">
      <div class="flex items-end gap-2 max-w-[85%]">
        <!-- アイコン（鎮火） -->
        <div class="flex-shrink-0 mb-1 text-stone-500 bg-stone-900/50 p-2 rounded-full border border-stone-700/50">
           <!-- 燃えかすのようなアイコン（Cloud or Archive） -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
             <path d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0016.5 9h-1.875a1.875 1.875 0 01-1.875-1.875V5.25A3.75 3.75 0 009 1.5H5.625z" />
             <path d="M12.971 1.816A5.23 5.23 0 0114.25 5.25v1.875c0 .207.168.375.375.375S15 7.332 15 7.125v-1.875a3.375 3.375 0 00-3.375-3.375h-3.25c-.207 0-.375.168-.375.375s.168.375.375.375h3.25c.264 0 .52.026.766.075z" />
          </svg>
        </div>
        <!-- メッセージ -->
        <div class="bg-stone-900/50 text-stone-500 rounded-2xl rounded-tl-none px-5 py-4 shadow-sm border border-stone-700/30">
          <p class="text-xs">火が弱まっているようです（応答なし）</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
