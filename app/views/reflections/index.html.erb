<% if user_signed_in? %>
  <%= turbo_stream_from "reflections_#{current_user.id}" %>
<% else %>
  <%= turbo_stream_from "reflections_public" %>
<% end %>
<div class="h-full bg-slate-900 relative overflow-hidden flex flex-col">
  <!-- 背景演出 -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute bottom-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-orange-600/20 rounded-full blur-[100px] animate-pulse"></div>
  </div>

  <!-- ヘッダー下部のスペース -->
  <div class="h-4 flex-shrink-0"></div>

  <!-- ゲストモード警告 (Sticky) -->
  <% unless user_signed_in? %>
    <div class="flex-shrink-0 px-4 pb-2 z-20 w-full max-w-2xl mx-auto">
      <div class="flex justify-center">
        <div class="bg-orange-900/60 border border-orange-500/30 text-orange-200 rounded-lg px-3 py-2 text-xs text-center backdrop-blur-md shadow-lg">
          🔥 現在は「ゲストモード」です。この焚き火は誰でも見ることができます。<br>
          <%= link_to "ログイン", new_user_session_path, class: "underline hover:text-white font-medium" %> すると、あなただけの焚き火になります。
        </div>
      </div>
    </div>
  <% end %>

  <!-- タイムライン -->
  <div id="reflections" class="flex-1 overflow-y-auto px-4 py-4 space-y-6 max-w-2xl mx-auto w-full z-10 overscroll-contain" data-controller="scroll">
    <!-- 最初のメッセージ -->

    
    <div class="flex justify-start">
      <div class="bg-slate-800 text-slate-300 rounded-2xl rounded-tl-none px-5 py-3 shadow-lg max-w-[85%] border border-slate-700/50">
        <p class="text-sm">ようこそ、焚き火リフレクションへ。今の気持ちや、今日あったことを少しずつ言葉にしてみましょう。</p>
      </div>
    </div>

    <%= render @reflections %>
  </div>

  <!-- 入力エリア -->
  <div class="flex-shrink-0 bg-slate-900/80 backdrop-blur border-t border-slate-800 p-4 z-20 pb-safe">
    <div class="max-w-2xl mx-auto">
      <%= form_with(model: @reflection, class: "flex gap-2 items-end", data: { controller: "reflection-form", action: "turbo:submit-end->reflection-form#clear" }) do |f| %>
        <%= f.text_area :content, 
            rows: 1, 
            placeholder: "今、何を感じていますか？ (Ctrl + Enterで送信)", 
            class: "block w-full rounded-xl border-0 bg-slate-800 py-3 pl-4 pr-4 text-slate-100 placeholder:text-slate-500 focus:ring-2 focus:ring-orange-600 sm:text-sm sm:leading-6 resize-none max-h-40 overflow-y-auto",
            data: { reflection_form_target: "input", action: "keydown->reflection-form#submit input->reflection-form#resize" }
        %>
        <%= f.button type: "submit", class: "rounded-full bg-orange-600 p-3 text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 transition-all flex-shrink-0 mb-[1px]" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5zM15.3 15.3a.75.75 0 01.75.75 1.5 1.5 0 001.5 1.5.75.75 0 010 1.5 1.5 1.5 0 00-1.5 1.5.75.75 0 01-1.5 0 1.5 1.5 0 00-1.5-1.5.75.75 0 010-1.5 1.5 1.5 0 001.5-1.5.75.75 0 01.75-.75zM17.25 5.25a.75.75 0 01.75.75 1.5 1.5 0 001.5 1.5.75.75 0 010 1.5 1.5 1.5 0 00-1.5 1.5.75.75 0 01-1.5 0 1.5 1.5 0 00-1.5-1.5.75.75 0 010-1.5 1.5 1.5 0 001.5-1.5.75.75 0 01.75-.75z" clip-rule="evenodd" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
