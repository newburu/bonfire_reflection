<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bonfire Reflection" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bonfire Reflection">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-slate-900 text-slate-200">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur supports-[backdrop-filter]:bg-slate-900/60 sticky top-0 z-50">
      <nav class="mx-auto flex max-w-7xl items-center justify-between p-4 lg:px-8" aria-label="Global">
        <div class="flex lg:flex-1">
          <%= link_to root_path, class: "-m-1.5 p-1.5 flex items-center gap-2 group" do %>
            <span class="text-2xl">🔥</span>
            <span class="font-bold text-slate-100 group-hover:text-orange-500 transition-colors">Bonfire</span>
          <% end %>
          <% if user_signed_in? %>
            <%= link_to "リフレクション", reflections_path, class: "ml-6 text-sm font-semibold leading-6 text-slate-300 hover:text-white transition-colors" %>
          <% end %>
        </div>
        <div class="flex flex-1 justify-end gap-x-6 items-center">
          <% if user_signed_in? %>
            <div class="flex items-center gap-3">
              <% if current_user.image.present? %>
                <%= image_tag current_user.image, class: "h-8 w-8 rounded-full bg-slate-800 ring-2 ring-slate-800" %>
              <% else %>
                <div class="h-8 w-8 rounded-full bg-slate-700 flex items-center justify-center text-xs text-white ring-2 ring-slate-800">
                  <%= current_user.name&.first&.upcase || "U" %>
                </div>
              <% end %>
              <span class="text-sm font-medium text-slate-300 hidden sm:block"><%= current_user.name %></span>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "text-sm font-semibold leading-6 text-slate-400 hover:text-white transition-colors" do %>
              ログアウト
            <% end %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "text-sm font-semibold leading-6 text-slate-300 hover:text-white transition-colors" %>
          <% end %>
        </div>
      </nav>
    </header>
    <%= yield %>
  </body>
</html>
